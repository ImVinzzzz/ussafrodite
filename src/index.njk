---
layout: layouts/base.njk
title: Home
---
{#- Home / dashboard LCARS. Contatori calcolati automaticamente dai contenuti. -#}
{% set logCount = collections.diaries.length + collections.reunions.length %}
<div class="home-hero animate-in">
  <div class="hero-main">
    <div class="hero-brand">
      <img src="/assets/img/logo.svg" alt="{{ site.name }}" class="hero-logo" width="90" height="90">
      <div>
        <h1 class="hero-ship-name">{{ site.name }}</h1>
        <div class="hero-registry">NCC - 1863</div>
        <div class="hero-motto"><b>{{ site.motto }}</b></div>
      </div>
    </div>
    <div class="hero-class">
      <p>Flotta Stellare · Federazione Unita dei Pianeti</p>
      <p class="hero-access">
        <span class="stardate-value">Access: <span class="text-orange">GRANTED!</span></span><br>
        Il sistema LCARS raccoglie i registri di missione, i diari e i fascicoli dell'equipaggio, nonché le
        specifiche della nave e le comunicazioni interne.
      </p>
      <p class="hero-stardate">Stardate: <span class="js-stardate"></span></p>
    </div>
  </div>

  <div class="hero-stats">
    <div class="stat-block">
      <div class="stat-label"><i class="fa-solid fa-shield-halved"></i> &nbsp;Stato nave</div>
      <div class="stat-value text-sci">{{ site.status }}</div>
    </div>
    <div class="stat-block">
      <div class="stat-label"><i class="fa-solid fa-location-crosshairs"></i> &nbsp;Posizione</div>
      <div class="stat-value">{{ site.position }}</div>
    </div>
    <div class="stat-block">
      <div class="stat-label"><i class="fa-solid fa-bars-staggered"></i> &nbsp;Log di Missione</div>
      <div class="stat-value">{{ logCount }} <span class="stat-note">diari e rapporti pubblicati</span></div>
    </div>
    <div class="stat-block">
      <div class="stat-label"><i class="fa-solid fa-people-group"></i> &nbsp;Effettivo equipaggio</div>
      <div class="stat-value">{{ site.complement }} <span class="stat-note">Ufficiali, Sottufficiali e Civili</span></div>
    </div>
  </div>
</div>

<div class="section-grid">
  {% for s in [
    { key: 'log',  icon: 'fa-bars-staggered',       title: 'Log',  desc: 'Diari di missione' },
    { key: 'crew', icon: 'fa-people-group',         title: 'Crew', desc: "Fascicoli dell'equipaggio" },
    { key: 'ship', icon: 'fa-rocket',               title: 'Ship', desc: 'Specifiche tecniche della nave' },
    { key: 'padd', icon: 'fa-tablet-screen-button', title: 'PADD', desc: 'Comunicazioni e avvisi' }
  ] %}
  <a href="/{{ s.key }}/" class="section-card {{ s.key }} animate-in animate-in-delay-{{ loop.index }}">
    <div class="section-card-icon"><i class="fa-solid {{ s.icon }}"></i></div>
    <div class="section-card-title">{{ s.title }}</div>
    <div class="section-card-desc">{{ s.desc }}</div>
  </a>
  {% endfor %}
</div>

<div class="triviatrek-section animate-in animate-in-delay-5">
  <div class="triviatrek-header">
    <div class="triviatrek-title">
      <i class="fa-solid fa-trophy"></i> TriviaTrek - classifica<span class="title-extra"> generale</span>
    </div>
    <div class="triviatrek-badge">LCARS RANKING SYSTEM</div>
  </div>
  <div class="triviatrek-grid">
    {% for t in triviatrek %}
    <div class="triviatrek-card">
      <div class="triviatrek-rank">{{ loop.index }}°</div>
      <div class="triviatrek-img-wrap">
        <img src="/assets/img/{{ t.img }}" alt="{{ t.name }}" class="triviatrek-img" loading="lazy">
      </div>
      <div class="triviatrek-pg-name">{{ t.name }}</div>
      <div class="triviatrek-score">{{ t.score }} <span class="triviatrek-unit">pt</span></div>
      <div class="triviatrek-quizzes">Quiz affrontati: {{ t.quizzes }}</div>
      <div class="triviatrek-quizzes">Media: <strong>{{ t.avg }}</strong> pt</div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="section-grid2">
  <div class="hero-main">
    <p>
      <em>Diversi anni fa, 10 cadetti facenti parte della ACCADEMIA della FLOTTA STELLARE furono diplomati a forza e
        buttati fuori dopo i famosi eventi della Kobayashi Maru.
        Si rifugiarono a bordo della</em> <span class="stardate-value">USS AFRODITE</span> <em>dove hanno imparato a
        vivere sguazzando nei guai.
        Sono tuttora in giro per le NEBULE.</em><br><br>
    </p>
    <div>
      <p class="diary-em">Ma se avete una 'mission: impossible' da affrontare...<br>
        e disponete di un po' di NUTELLA non replicata...<br>
        forse potrete ingaggiare il famoso...</p>
      <img src="/assets/img/ateam.png" alt="A-Team" class="img-fluid mt-12" loading="lazy">
    </div>
  </div>

  {#- Registro aggiornamenti: voci in src/_data/registro.txt (dalla più vecchia alla più recente) -#}
  <section class="home-log animate-in animate-in-delay-1" aria-labelledby="home-log-title">
    <div class="home-log-head">
      <h2 class="home-log-title" id="home-log-title"><i class="fa-solid fa-terminal"></i> Log</h2>
      <span class="home-log-count">{{ registro.length }} ENTRIES</span>
    </div>
    <ol class="home-log-list js-home-log" tabindex="0" aria-label="Registro aggiornamenti, dal più vecchio al più recente">
      {%- for e in registro %}
      <li class="home-log-row">
        {%- if e.url %}<a href="{{ e.url }}">{% else %}<span>{% endif -%}
        <span class="home-log-text">{{ e.text }}</span>{% if e.sd %}<span class="home-log-sd">SD {{ e.sd }}</span>{% endif %}
        {%- if e.url %}</a>{% else %}</span>{% endif -%}
      </li>
      {%- endfor %}
      <li class="home-log-cursor" aria-hidden="true">_</li>
    </ol>
  </section>

  <a href="/archive/1999/index.htm" target="_blank" rel="noopener" class="section-card ship animate-in animate-in-delay-1">
    <div class="section-card-icon"><i class="fa-solid fa-link"></i></div>
    <div class="section-card-title">WEB 1.0</div>
    <div class="section-card-desc">Sito web originale <br>Versione 1999-2005</div>
  </a>
</div>

<div class="lcars-deco" aria-hidden="true">
  <div class="lcars-deco-dot"></div>
  <div class="lcars-deco-bar bar-lavender" style="flex:0.3"></div>
  <div class="lcars-deco-bar bar-blue" style="flex:0.5"></div>
  <div class="lcars-deco-bar bar-gold" style="flex:1"></div>
  <div class="lcars-deco-bar bar-lavender" style="flex:0.2"></div>
</div>
